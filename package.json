{
  "name": "speak-bot",
  "private": true,
  "version": "0.0.0",
  "description": "Assistive text-to-speech for people who cannot speak.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run build -w @speak-bot/mobile && npm start -w @speak-bot/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
