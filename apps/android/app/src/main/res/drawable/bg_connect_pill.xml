<?xml version="1.0" encoding="utf-8"?>
<!-- Solid dark blue with a light outline: white text reads at 5:1 and the pill stands out on light and dark pages. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/overlay_action" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/overlay_outline" />
</shape>
